#!/bin/sh /etc/rc.common
# Webcam Capture Service

START=90
USE_PROCD=1

CRONTAB=/etc/crontabs/root

# Aggiunge (una sola volta) i job cron necessari senza toccare quelli esistenti
ensure_cron() {
    local changed=0 entry cmd

    touch "$CRONTAB"
    for entry in \
        "*/3 * * * *|/usr/bin/heartbeat" \
        "*/5 * * * *|/usr/bin/climate"
    do
        cmd="${entry#*|}"
        if ! grep -q "^[^#].*$cmd" "$CRONTAB"; then
            echo "${entry%|*} $cmd" >> "$CRONTAB"
            changed=1
        fi
    done

    [ "$changed" = 1 ] && /etc/init.d/cron restart >/dev/null 2>&1
}

start_service() {
    ensure_cron

    procd_open_instance
    procd_set_param command /bin/sh /usr/bin/capture_service
    procd_set_param respawn 5000 5 5   # delay, retries, threshold
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

