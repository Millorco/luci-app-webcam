#!/bin/sh /etc/rc.common
# Webcam Capture Service

START=90
USE_PROCD=1

CRONTAB=/etc/crontabs/root

# Aggiunge (una sola volta) i job cron necessari senza toccare quelli esistenti
ensure_cron() {
    local changed=0 entry cmd

    touch "$CRONTAB"
    for entry in \
        "*/3 * * * *|/usr/bin/heartbeat" \
        "*/5 * * * *|/usr/bin/climate" \
        "0 */6 * * *|/usr/bin/inventory_report --cron" \
        "*/5 * * * *|/usr/bin/telemetry_sample --cron" \
        "*/30 * * * *|/usr/bin/telemetry_send --cron" \
        "* * * * *|/usr/libexec/webcam/commands --due"
    do
        cmd="${entry#*|}"
        if ! grep -q "^[^#].*$cmd" "$CRONTAB"; then
            echo "${entry%|*} $cmd" >> "$CRONTAB"
            changed=1
        fi
    done

    # crond di BusyBox scrive ogni job eseguito ("USER root pid ... cmd
    # /usr/bin/heartbeat") a livello err: con 9 registra solo i suoi errori
    if [ "$(uci -q get system.@system[0].cronloglevel)" != 9 ]; then
        uci -q set system.@system[0].cronloglevel=9 && uci -q commit system
        changed=1
    fi

    [ "$changed" = 1 ] && /etc/init.d/cron restart >/dev/null 2>&1
}

start_service() {
    ensure_cron

    # Dati del router all'inventario delle webcam, se configurato
    if [ -n "$(uci -q get webcam.@general[0].inventory_url)" ]; then
        ( /usr/bin/inventory_report --boot ) >/dev/null 2>&1 </dev/null &
    fi

    # Comandi del portal rimasti in attesa mentre il router era spento:
    # GET /api/v1/commands fra 2 minuti (rete e 4G pronti), da cron
    if [ "$(uci -q get webcam.@server[0].commands)" != 0 ] && \
        [ -n "$(uci -q get webcam.@server[0].portal_url)" ]; then
        /usr/libexec/webcam/commands --schedule 120 >/dev/null 2>&1
    fi

    procd_open_instance
    procd_set_param command /bin/sh /usr/bin/capture_service
    procd_set_param respawn 5000 5 5   # delay, retries, threshold
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# Contatori della fotocamera nella flash prima di uno spegnimento
# ordinato (riavvio, aggiornamento); altrimenti si salvano ogni ora
stop_service() {
    /usr/bin/telemetry_sample --save-counters >/dev/null 2>&1
}

