#
# Webcam setting
#
config general 'general'
        option maintenance_mode '1'
        option latitude '41.929308'
        option longitude '12.464880'
        option temp_scale 'c'
        option ext_sensor '0'
        option heating '0'
        option heat_dewpoint_margin '3'
        option heat_hysteresis '2'
        option heat_min_temp '3'
        option heat_fan '1'
        option serial_port '/dev/ttyS1'
        option baud_rates '9600'
        option ping_url ''
        option inventory_url ''
        option inventory_token ''
        option ntp_wait '30'
        option update_check '1'
        option update_url ''
        # Victron VE.Direct-USB (regolatore MPPT, SmartShunt facoltativo)
        option victron '0'
        option victron_port '/dev/ttyUSB0'
        option victron_shunt_port ''
        # Chiavetta 4G HiLink (es. Huawei E3372h): dati radio dalla sua API
        option hilink '1'
        option hilink_addr '192.168.8.1'
        # Valore iniziale del contatore degli scatti (vuoto = non usato)
        option shots_initial ''

config shooting 'shooting'
        option photo_name 'raw'
        option photo_time_lapse '10'
        option sunrise_offset '0'
        option sunset_offset '0'

config day 'day'
        # Valori = indici delle scelte di gphoto2 (vedi *_data.json),
        # pensati per la ghiera su M: ISO Auto, f/8, 1/500
        option iso_day '0'
        option aperture_day '4'
        option shutterspeed_day '43'

config night 'night'
        # ISO 1600, diaframma più aperto dell'obiettivo (f/5), 15"
        option iso_night '5'
        option aperture_night '0'
        option shutterspeed_night '4'

config server 'server'
        option upload_protocol 'ftp'
        option upload_server 'example.com'
        option upload_directory 'photos'
        option upload_username 'user'
        option upload_password 'passw'
        option upload_date_dirs '1'
        option upload_latest '1'
        option upload_latest_name 'current'
        option upload_data '1'
        option queue_size '20'
        option queue_dir ''
        # Portal Webcam 2.0: URL base e token della webcam (wct_...)
        option portal_url ''
        option portal_token ''
        # Destinazione delle foto: portal, ftp, both; vuoto = portal se
        # portal_url è impostato, altrimenti ftp
        option upload_target ''
        option telemetry '1'
        # Comandi dal portal (riscaldamento, scatto, invio telemetria,
        # 7 opzioni): 0 = il router non li chiede e non li esegue
        option commands '1'

# Fasce orarie con un intervallo di scatto diverso (es. Capodanno).
# date: vuoto = ogni giorno, MM-GG = ogni anno, AAAA-MM-GG = una volta;
# per una fascia che passa la mezzanotte è il giorno in cui inizia.
config special
        option enabled '0'
        option name 'Capodanno'
        option date '12-31'
        option start '23:50'
        option end '00:10'
        option interval '1'

