#
# Webcam setting
#
config general 'general'
        option maintenance_mode '1'
        option latitude '41.929308'
        option longitude '12.464880'
        option temp_scale 'c'
        option heating '0'
        option heat_dewpoint_margin '3'
        option heat_hysteresis '2'
        option heat_min_temp '3'
        option heat_fan '1'
        option serial_port '/dev/ttyS1'
        option baud_rates '9600'

config shooting 'shooting'
        option photo_name 'raw'
        option photo_time_lapse '10'
        option sunrise_offset '0'
        option sunset_offset '0'

config day 'day'
        option iso_day ''
        option aperture_day ''
        option shutterspeed_day ''

config night 'night'
        option iso_night ''
        option aperture_night ''
        option shutterspeed_night ''

config server 'server'
        option upload_protocol 'ftp'
        option upload_server 'example.com'
        option upload_directory 'photos'
        option upload_username 'user'
        option upload_password 'passw'
        option upload_date_dirs '0'
        option upload_latest '0'
        option upload_latest_name 'current'
        option upload_data '0'

# Fasce orarie con un intervallo di scatto diverso (es. Capodanno).
# date: vuoto = ogni giorno, MM-GG = ogni anno, AAAA-MM-GG = una volta;
# per una fascia che passa la mezzanotte è il giorno in cui inizia.
config special
        option enabled '0'
        option name 'Capodanno'
        option date '12-31'
        option start '23:50'
        option end '00:10'
        option interval '1'

