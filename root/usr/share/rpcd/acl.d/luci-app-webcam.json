{
  "luci-app-webcam": {
    "description": "Grant UCI and file access to LuCI app Webcam",
    "read": {
      "file": {
        "/tmp/webcam/status.json": [
          "read"
        ],
        "/tmp/webcam/capture.json": [
          "read"
        ],
        "/usr/share/webcam/version": [
          "read"
        ],
        "/tmp/webcam/updates.json": [
          "read"
        ],
        "/tmp/webcam/photo/*": [
          "read"
        ]
      },
      "uci": [
        "webcam"
      ]
    },
    "write": {
      "uci": [
        "webcam"
      ],
      "file": {
        "/usr/bin/capture_now": [
          "exec"
        ],
        "/usr/bin/capture_now *": [
          "exec"
        ],
        "/usr/bin/check_updates": [
          "exec"
        ],
        "/usr/bin/check_updates *": [
          "exec"
        ]
      }
    }
  }
}
