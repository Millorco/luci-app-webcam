{
  "luci-app-webcam": {
    "description": "Grant UCI and file access to LuCI app Webcam",
    "read": {
      "file": {
        "/tmp/webcam/status.json": [ "read" ],
        "/tmp/webcam/capture.json": [ "read" ]
      },
      "uci": [
        "webcam"
      ]
    },
    "write": {
      "uci": [
        "webcam"
      ]
    }
  }
}
