#!/bin/sh
# ---------------------------------------------------
# Ping al servizio di monitoraggio: Uptime Kuma (monitor Push) oppure
# healthchecks.io / Healthchecks self-hosted.
#
# Uso: hc_ping [-w] ok|fail|log [messaggio]
#   ok    scatto e upload riusciti (il monitor resta verde)
#   fail  errore: il monitor va subito in allarme
#   log   solo una riga nel registro del check (Healthchecks); con
#         Uptime Kuma, che non ha un registro, va solo nel log del router
#   -w    rete forse non ancora pronta (avvio): riprova più a lungo
#
# L'URL è l'opzione webcam.@general[0].ping_url:
#   Uptime Kuma  https://monitoring.example.com/api/push/<token>
#                (anche con ?status=up&msg=OK&ping= copiato da Kuma:
#                i parametri li mette lo script)
#   Healthchecks https://hc-ping.com/<uuid>
# Se è vuota non fa nulla.
# ---------------------------------------------------

TRIES=3
[ "$1" = -w ] && { TRIES=12; shift; }
KIND="${1:-ok}"
MSG="$2"

case "$KIND" in
	ok|fail|log) ;;
	*) echo "Uso: $0 [-w] ok|fail|log [messaggio]" >&2; exit 2 ;;
esac

URL="$(uci -q get webcam.@general[0].ping_url)"
[ -n "$URL" ] || exit 0

case "$URL" in
	http://*|https://*) ;;
	*) logger -t "webcam ping" "ping_url non valido: deve iniziare con http:// o https://"; exit 1 ;;
esac

case "$URL" in
	*/api/push/*)
		# Uptime Kuma: GET con status e msg (max 250 caratteri)
		URL="${URL%%\?*}"
		case "$KIND" in
			log) logger -t "webcam ping" "$MSG"; exit 0 ;;
			ok)  STATUS=up;   [ -n "$MSG" ] || MSG=OK ;;
			fail) STATUS=down ;;
		esac
		MSG="$(printf '%s' "$MSG" | tr '\n\r' '  ' | cut -c1-250)"
		set -- -G --data-urlencode "status=$STATUS" --data-urlencode "msg=$MSG" --data-urlencode "ping="
		;;
	*)
		# Healthchecks: POST, il corpo (max 100 kB) va nel registro del check
		URL="${URL%/}"
		[ "$KIND" = ok ] || URL="$URL/$KIND"
		set -- --data-raw "$MSG"
		;;
esac

i=1
while :; do
	curl -fsS -m 10 -o /dev/null "$@" "$URL" 2>/dev/null && exit 0
	[ "$i" -ge "$TRIES" ] && break
	i=$((i + 1))
	sleep 10
done

logger -t "webcam ping" "Ping '$KIND' non riuscito dopo $TRIES tentativi"
exit 1
