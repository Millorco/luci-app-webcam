#!/bin/sh

WC_NAME="$(uci -q get system.@system[0].hostname)"
LOGTAG="${WC_NAME:-webcam} capture"
SCHEDULE=/usr/libexec/webcam/schedule
PING=/usr/libexec/webcam/hc_ping

# Livello syslog dal prefisso del messaggio, così in VictoriaLogs gli
# errori sono rossi, gli avvisi gialli e le foto caricate verdi.
log_prio() {
    case "$1" in
        ERRORE*) echo user.err ;;
        ATTENZIONE*) echo user.warning ;;
        OK*) echo user.info ;;
        *) echo user.notice ;;
    esac
}

log() {
    logger -p "$(log_prio "$*")" -t "$LOGTAG" "$@"
}

LAST_SPECIAL=""
LAST_MAINT=""

# ---------------------------------------------------
# Attesa dell'ora giusta. Il router non ha un orologio a batteria: dopo
# un riavvio (anche un ciclo del watchdog) l'ora riparte da quella
# dell'ultimo file salvato in flash. Uno scatto in quel momento avrebbe
# data e ora vecchie: finirebbe nella cartella sbagliata, userebbe le
# impostazioni del giorno o della notte a caso e potrebbe sovrascrivere
# sul server una foto già caricata con lo stesso nome.
# Il flag è creato da /etc/hotplug.d/ntp/25-webcam quando sysntpd
# sincronizza l'ora.
# ---------------------------------------------------
NTP_FLAG=/var/run/webcam_ntp_synced
MIN_YEAR=2025   # un anno precedente vuol dire orologio certamente sbagliato

clock_plausible() {
    [ "$(date +%Y)" -ge "$MIN_YEAR" ]
}

ntp_client_enabled() {
    [ "$(uci -q get system.ntp.enabled)" != 0 ] && [ -n "$(uci -q get system.ntp.server)" ]
}

wait_for_clock() {
    local wait waited=0 warned=0

    [ -f "$NTP_FLAG" ] && return 0

    if ! ntp_client_enabled; then
        if clock_plausible; then
            log "Client NTP disattivato: non attendo la sincronizzazione dell'ora."
            return 0
        fi
        log "ERRORE: client NTP disattivato e ora del router non valida ($(date)): attivalo in Sistema > Sistema."
    fi

    # Minuti massimi di attesa; 0 = attende senza limite
    wait="$(uci -q get webcam.@general[0].ntp_wait)"
    case "$wait" in
        ''|*[!0-9]*) wait=30 ;;
    esac

    log "Attendo la sincronizzazione dell'ora con NTP prima di scattare (ora attuale $(date '+%Y-%m-%d %H:%M'))."
    while [ ! -f "$NTP_FLAG" ]; do
        if [ "$wait" -gt 0 ] && [ "$waited" -ge $(( wait * 60 )) ]; then
            if clock_plausible; then
                log "ATTENZIONE: ora non sincronizzata dopo $wait minuti, scatto comunque: data e ora delle foto potrebbero essere sbagliate."
                "$PING" log "${WC_NAME:-webcam}: ora non sincronizzata con NTP dopo $wait minuti, scatto comunque" </dev/null >/dev/null 2>&1 &
                return 1
            fi
            if [ "$warned" = 0 ]; then
                log "ERRORE: ora del router non valida ($(date)) e nessuna risposta NTP: non scatto finché l'ora non è corretta."
                warned=1
            fi
        fi
        sleep 10
        waited=$(( waited + 10 ))
    done

    log "Ora sincronizzata con NTP dopo $waited s: $(date '+%Y-%m-%d %H:%M')."
    return 0
}

# Avvio del servizio (anche dopo un riavvio del router): una riga nel
# registro del check con l'uptime, così i riavvii inattesi si vedono.
UPTIME=$(cut -d. -f1 /proc/uptime)
"$PING" -w log "${WC_NAME:-webcam}: servizio avviato, router acceso da $UPTIME s" </dev/null >/dev/null 2>&1 &

wait_for_clock

while true; do
    # Read configuration values with fallback defaults
    WC_TIME_LAPSE="$(uci -q get webcam.@shooting[0].photo_time_lapse)"
    WC_MAINTENANCE_MODE="$(uci -q get webcam.@general[0].maintenance_mode)"

    # Sanity checks
    case "$WC_TIME_LAPSE" in
        ''|*[!0-9]*|0)
            log "ATTENZIONE: intervallo di scatto 'photo_time_lapse' mancante o non valido, uso 10 minuti."
            WC_TIME_LAPSE=10
            ;;
    esac

    [ -z "$WC_MAINTENANCE_MODE" ] && WC_MAINTENANCE_MODE=0

    # In manutenzione non si scatta, quindi il check andrà in allarme:
    # lo si segnala nel registro del check quando cambia lo stato.
    if [ "$WC_MAINTENANCE_MODE" != "$LAST_MAINT" ]; then
        if [ "$WC_MAINTENANCE_MODE" = 1 ]; then
            "$PING" log "${WC_NAME:-webcam}: modalità manutenzione attiva, nessuno scatto" </dev/null >/dev/null 2>&1 &
        elif [ -n "$LAST_MAINT" ]; then
            "$PING" log "${WC_NAME:-webcam}: modalità manutenzione terminata" </dev/null >/dev/null 2>&1 &
        fi
        LAST_MAINT="$WC_MAINTENANCE_MODE"
    fi

    START=$(date +%s)

    # Fascia oraria speciale attiva? Il suo intervallo sostituisce quello normale
    read -r SP_INTERVAL SP_NEXT SP_NAME <<EOF
$($SCHEDULE "$START")
EOF
    INTERVAL="$WC_TIME_LAPSE"
    WC_SPECIAL=""
    if [ -n "$SP_INTERVAL" ] && [ "$SP_INTERVAL" != - ]; then
        INTERVAL="$SP_INTERVAL"
        WC_SPECIAL="${SP_NAME:-special}"
    fi
    if [ "$WC_SPECIAL" != "$LAST_SPECIAL" ]; then
        if [ -n "$WC_SPECIAL" ]; then
            log "Fascia speciale '$WC_SPECIAL': uno scatto ogni $INTERVAL minuti."
        else
            log "Fine della fascia speciale '$LAST_SPECIAL': uno scatto ogni $INTERVAL minuti."
        fi
        LAST_SPECIAL="$WC_SPECIAL"
    fi
    # capture limita a metà intervallo il tempo per svuotare la coda di upload
    WC_INTERVAL="$INTERVAL"
    export WC_SPECIAL WC_INTERVAL

    # Check maintenance mode
    if [ "$WC_MAINTENANCE_MODE" -eq 0 ]; then
        /usr/bin/capture
        RC=$?
        # capture ha già scritto il motivo come ERRORE; qui solo i casi anomali
        case "$RC" in
            0|1|3) ;;
            *) log "ERRORE: capture terminato in modo anomalo (codice $RC)" ;;
        esac
    else
        log "Modalità manutenzione attiva: nessuno scatto."
    fi

    # Sleep for the rest of the interval, so the shot duration doesn't add up
    ELAPSED=$(( $(date +%s) - START ))
    REMAINING=$(( INTERVAL * 60 - ELAPSED ))
    [ "$REMAINING" -lt 10 ] && REMAINING=10

    # Svegliarsi prima se nel frattempo una fascia speciale inizia o finisce
    read -r SP_INTERVAL SP_NEXT SP_NAME <<EOF
$($SCHEDULE)
EOF
    case "$SP_NEXT" in
        ''|-|*[!0-9]*) ;;
        *) [ "$SP_NEXT" -lt "$REMAINING" ] && REMAINING="$SP_NEXT" ;;
    esac
    [ "$REMAINING" -lt 1 ] && REMAINING=1

    sleep "$REMAINING"
done
