#!/bin/sh
# ---------------------------------------------------
# Spegne tutti i LED del router, così non si riflettono nella foto.
#
# Per ogni LED in /sys/class/leds imposta in /etc/config/system
# trigger 'none' e default '0': le sezioni LED già presenti vengono
# modificate, per gli altri LED ne viene creata una (webcam_led_*).
# I LED si spengono subito e restano spenti dopo il riavvio.
# Si può eseguire più volte: il risultato è sempre lo stesso.
#
# Viene eseguito all'installazione (/etc/uci-defaults/90-webcam-leds).
# Per tenere i LED accesi: uci set webcam.general.leds_off=0
# ---------------------------------------------------

if [ "$(uci -q get webcam.general.leds_off)" = 0 ]; then
	echo "LED lasciati accesi (webcam.general.leds_off=0)"
	exit 0
fi

[ -d /sys/class/leds ] || { echo "Nessun LED trovato"; exit 0; }

# LED già descritti in /etc/config/system
covered=""
for s in $(uci -q show system | sed -n 's/^system\.\([^.=]*\)=led$/\1/p'); do
	uci set "system.$s.trigger=none"
	uci set "system.$s.default=0"
	covered="$covered
$(uci -q get "system.$s.sysfs")"
done

n=0
for d in /sys/class/leds/*; do
	[ -e "$d" ] || continue
	led="${d##*/}"
	n=$((n + 1))

	if ! printf '%s\n' "$covered" | grep -qxF "$led"; then
		s="webcam_led_$(printf '%s' "$led" | tr -c 'A-Za-z0-9_' '_')"
		uci set "system.$s=led"
		uci set "system.$s.name=$led"
		uci set "system.$s.sysfs=$led"
		uci set "system.$s.trigger=none"
		uci set "system.$s.default=0"
	fi

	# Spegnimento immediato
	echo none > "$d/trigger" 2>/dev/null
	echo 0 > "$d/brightness" 2>/dev/null
done

[ -n "$(uci -q changes system)" ] && uci commit system

echo "LED spenti: $n"
exit 0
