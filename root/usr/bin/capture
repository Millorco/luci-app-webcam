#!/bin/sh
# ---------------------------------------------------
#
# Scatto con fotocamera Canon EOS tramite gphoto2 e upload della foto
#
# ---------------------------------------------------

. /usr/bin/webcam.cfg

SERIAL=/usr/libexec/webcam/serial
CAPTURE_FLAG="$WC_STATE_DIR/capturing"
HEATER_STATE="$WC_STATE_DIR/heater"
CAPTURE_JSON="$WC_STATE_DIR/capture.json"
WORK_DIR=/tmp/webcam/photo

mkdir -p "$WORK_DIR"
cd "$WORK_DIR" || exit 1

NOW_DATE="$(date +"%Y%m%d-%H%M")"
FILENAME="${WC_PHOTO_NAME}_${NOW_DATE}.jpg"
MODE=""

log() {
	echo "$@" >&2
	logger -t "$WC_NAME capture" "$@"
}

write_status() {
	cat > "$CAPTURE_JSON.tmp" <<JSON
{
  "time": $(date +%s),
  "mode": "$MODE",
  "file": "$FILENAME",
  "result": "$1"
}
JSON
	mv "$CAPTURE_JSON.tmp" "$CAPTURE_JSON"
}

fail() {
	log "ERRORE: $1"
	write_status "$1"
	exit 1
}

# ---------------------------------------------------
# Giorno o notte? Alba e tramonto sono calcolati in locale
# dalle coordinate, senza dipendere da servizi esterni.
# ---------------------------------------------------
day_or_night() {
	local now sun sunrise sunset
	now=$(date +%s)

	if [ -z "$WC_LATITUDE" ] || [ -z "$WC_LONGITUDE" ]; then
		log "Coordinate non impostate: uso le impostazioni diurne."
		echo day
		return
	fi

	sun=$(/usr/libexec/webcam/sun_times "$WC_LATITUDE" "$WC_LONGITUDE" "$now")
	case "$sun" in
		polar_day)   echo day;   return ;;
		polar_night) echo night; return ;;
	esac

	sunrise=${sun% *}
	sunset=${sun#* }
	case "$sunrise$sunset" in
		''|*[!0-9]*)
			log "Calcolo alba/tramonto fallito ('$sun'): uso le impostazioni diurne."
			echo day
			return
			;;
	esac

	if [ "$now" -ge "$sunrise" ] && [ "$now" -lt "$sunset" ]; then
		echo day
	else
		echo night
	fi
}

# ---------------------------------------------------
# Scatto. I valori salvati in UCI sono gli indici delle scelte
# di gphoto2 (vedi iso_data.json ecc.), quindi si usa
# --set-config-index: con --set-config un indice come "1" verrebbe
# interpretato come etichetta (es. tempo di 1 secondo).
# ---------------------------------------------------
shoot() {
	local iso="$1" aperture="$2" shutter="$3"

	gphoto2 --set-config eosremoterelease=3 \
		--set-config eosremoterelease=4 \
		--set-config-index iso="$iso" \
		--set-config-index aperture="$aperture" \
		--set-config-index shutterspeed="$shutter" \
		--capture-image-and-download \
		--force-overwrite \
		--filename "$FILENAME" >/dev/null 2>"$WORK_DIR/gphoto2.err"
}

capture() {
	local iso aperture shutter rc

	if [ "$MODE" = day ]; then
		iso="$WC_ISO_DAY"; aperture="$WC_APERTURE_DAY"; shutter="$WC_SHUTTERSPEED_DAY"
	else
		iso="$WC_ISO_NIGHT"; aperture="$WC_APERTURE_NIGHT"; shutter="$WC_SHUTTERSPEED_NIGHT"
	fi

	rm -f "$WORK_DIR"/*.jpg 2>/dev/null

	# Spegne il riscaldamento durante lo scatto per avere abbastanza corrente
	touch "$CAPTURE_FLAG"
	if [ "$WC_HEATING" = 1 ] && [ "$(cat "$HEATER_STATE" 2>/dev/null)" = 1 ]; then
		$SERIAL send h
	fi

	shoot "$iso" "$aperture" "$shutter"
	rc=$?
	if [ "$rc" -ne 0 ] || [ ! -f "$FILENAME" ]; then
		log "Primo tentativo fallito: $(tail -n 3 "$WORK_DIR/gphoto2.err" | tr '\n' ' ')"
		sleep 10
		shoot "$iso" "$aperture" "$shutter"
		rc=$?
	fi

	# Ripristina il riscaldamento (il controllo anti-appannamento potrebbe
	# averne cambiato lo stato desiderato nel frattempo)
	rm -f "$CAPTURE_FLAG"
	if [ "$WC_HEATING" = 1 ] && [ "$(cat "$HEATER_STATE" 2>/dev/null)" = 1 ]; then
		$SERIAL send H
	fi

	if [ "$rc" -ne 0 ] || [ ! -f "$FILENAME" ]; then
		fail "scatto fallito: $(tail -n 3 "$WORK_DIR/gphoto2.err" | tr '\n' ' ')"
	fi
}

# ---------------------------------------------------
# Upload: ftp, ftps (FTP su TLS) o sftp
# ---------------------------------------------------
upload() {
	local url port dir

	[ -n "$WC_UPLOAD_SERVER" ] || fail "server di upload non configurato"

	port=""
	[ -n "$WC_UPLOAD_PORT" ] && port=":$WC_UPLOAD_PORT"
	dir="${WC_UPLOAD_DIRECTORY#/}"
	dir="${dir%/}"
	[ -n "$dir" ] && dir="$dir/"

	set -- -s -S --connect-timeout 30 --retry 2 -T "$FILENAME" \
		--user "$WC_UPLOAD_USERNAME:$WC_UPLOAD_PASSWORD" --ftp-create-dirs

	case "$WC_UPLOAD_PROTOCOL" in
		ftps)
			# FTP esplicito su TLS: la connessione deve essere cifrata
			set -- "$@" --ssl-reqd
			[ "$WC_UPLOAD_INSECURE" = 1 ] && set -- "$@" --insecure
			url="ftp://$WC_UPLOAD_SERVER$port/$dir$FILENAME"
			;;
		sftp)
			curl -V 2>/dev/null | grep -q '^Protocols:.*sftp' || \
				fail "il curl installato non supporta SFTP (serve curl compilato con libssh2)"
			[ -n "$WC_UPLOAD_KEY" ] && set -- "$@" --key "$WC_UPLOAD_KEY"
			[ "$WC_UPLOAD_INSECURE" = 1 ] && set -- "$@" --insecure
			# "~/" = percorso relativo alla home dell'utente sul server
			url="sftp://$WC_UPLOAD_SERVER$port/~/$dir$FILENAME"
			;;
		*)
			url="ftp://$WC_UPLOAD_SERVER$port/$dir$FILENAME"
			;;
	esac

	if curl "$@" "$url"; then
		log "Upload completato: $FILENAME ($MODE, $WC_UPLOAD_PROTOCOL)"
		write_status ok
	else
		fail "upload fallito verso $WC_UPLOAD_PROTOCOL://$WC_UPLOAD_SERVER$port/$dir"
	fi
}

MODE=$(day_or_night)
capture
upload
exit 0
