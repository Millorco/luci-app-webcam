#!/bin/sh
# ---------------------------------------------------
#
# Scatto con fotocamera Canon EOS tramite gphoto2 e upload della foto
#
# Uso: capture [--no-upload]
#   --no-upload  scatto di prova: la foto resta solo sul router
#                (anteprima nella pagina Status), niente upload
#
# ---------------------------------------------------

. /usr/bin/webcam.cfg

SERIAL=/usr/libexec/webcam/serial
PING=/usr/libexec/webcam/hc_ping
CAPTURE_FLAG="$WC_STATE_DIR/capturing"
HEATER_STATE="$WC_STATE_DIR/heater"
CAPTURE_JSON="$WC_STATE_DIR/capture.json"
WORK_DIR=/tmp/webcam/photo
LOCK_DIR=/var/lock/webcam_capture.lock
LOCK_STALE=900        # un lock più vecchio di così è considerato orfano

NO_UPLOAD=0
case "$1" in
	--no-upload) NO_UPLOAD=1 ;;
	'') ;;
	*) echo "Uso: $0 [--no-upload]" >&2; exit 2 ;;
esac

mkdir -p "$WORK_DIR"
cd "$WORK_DIR" || exit 1

# Un solo scatto alla volta: il pulsante "Scatta ora" di LuCI e il
# servizio potrebbero partire insieme e contendersi la fotocamera.
take_lock() {
	mkdir "$LOCK_DIR" 2>/dev/null && return 0
	# Lock rimasto da uno scatto terminato in modo anomalo
	if [ $(( $(date +%s) - $(date -r "$LOCK_DIR" +%s 2>/dev/null || echo 0) )) -gt "$LOCK_STALE" ]; then
		rmdir "$LOCK_DIR" 2>/dev/null
		mkdir "$LOCK_DIR" 2>/dev/null && return 0
	fi
	return 1
}
if ! take_lock; then
	logger -t "$WC_NAME capture" "Uno scatto è già in corso: questo viene saltato."
	echo "Uno scatto è già in corso." >&2
	exit 3
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT
trap 'exit 1' INT TERM

# Un solo istante di riferimento per nome file, cartelle e dati
NOW=$(date +%s)
NOW_DATE="$(date -d "@$NOW" +"%Y%m%d-%H%M")"
FILENAME="${WC_PHOTO_NAME}_${NOW_DATE}.jpg"
DATAFILE="${FILENAME%.jpg}.json"
MODE=""
SUNRISE=""
SUNSET=""
# Nome della fascia oraria speciale attiva (impostato da capture_service)
SPECIAL="${WC_SPECIAL:-}"

log() {
	echo "$@" >&2
	logger -t "$WC_NAME capture" "$@"
}

# Stringa JSON con escape di \ e " (null se vuota). Gli a capo e le
# tabulazioni diventano spazi, così un messaggio d'errore non rompe il file.
json_str() {
	[ -n "$1" ] || { echo null; return; }
	printf '"%s"' "$(printf '%s' "$1" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

json_num() {
	case "$1" in
		''|*[!0-9-]*) echo null ;;
		*) echo "$1" ;;
	esac
}

write_status() {
	cat > "$CAPTURE_JSON.tmp" <<JSON
{
  "time": $(date +%s),
  "mode": $(json_str "$MODE"),
  "special": $(json_str "$SPECIAL"),
  "file": $(json_str "$FILENAME"),
  "upload": $( [ "$NO_UPLOAD" = 1 ] && echo false || echo true ),
  "result": $(json_str "$1")
}
JSON
	mv "$CAPTURE_JSON.tmp" "$CAPTURE_JSON"
}

# Ping al servizio di monitoraggio (healthchecks.io), in background per non
# ritardare lo scatto. Gli scatti di prova senza upload non contano.
ping_monitor() {
	[ "$NO_UPLOAD" = 1 ] && return
	"$PING" "$1" "$WC_NAME: $2" </dev/null >/dev/null 2>&1 &
}

fail() {
	log "ERRORE: $1"
	write_status "$1"
	ping_monitor fail "$1"
	exit 1
}

# ---------------------------------------------------
# Giorno o notte? Alba e tramonto sono calcolati in locale
# dalle coordinate, senza dipendere da servizi esterni.
# Gli scostamenti (minuti, anche negativi) spostano il passaggio:
# es. alba -30 e tramonto +30 usano le impostazioni diurne da mezz'ora
# prima dell'alba a mezz'ora dopo il tramonto, quando il cielo è ancora chiaro.
# Imposta MODE, SUNRISE e SUNSET (inizio e fine delle impostazioni diurne).
# ---------------------------------------------------
offset_minutes() {
	case "$1" in
		''|-|*[!0-9-]*|?*-*) echo 0 ;;
		*) echo "$1" ;;
	esac
}

day_or_night() {
	local sun

	MODE=day
	if [ -z "$WC_LATITUDE" ] || [ -z "$WC_LONGITUDE" ]; then
		log "Coordinate non impostate: uso le impostazioni diurne."
		return
	fi

	sun=$(/usr/libexec/webcam/sun_times "$WC_LATITUDE" "$WC_LONGITUDE" "$NOW")
	case "$sun" in
		polar_day)   MODE=day;   return ;;
		polar_night) MODE=night; return ;;
	esac

	SUNRISE=${sun% *}
	SUNSET=${sun#* }
	case "$SUNRISE$SUNSET" in
		''|*[!0-9]*)
			log "Calcolo alba/tramonto fallito ('$sun'): uso le impostazioni diurne."
			SUNRISE=""; SUNSET=""
			return
			;;
	esac

	SUNRISE=$(( SUNRISE + $(offset_minutes "$WC_SUNRISE_OFFSET") * 60 ))
	SUNSET=$(( SUNSET + $(offset_minutes "$WC_SUNSET_OFFSET") * 60 ))

	if [ "$NOW" -ge "$SUNRISE" ] && [ "$NOW" -lt "$SUNSET" ]; then
		MODE=day
	else
		MODE=night
	fi
}

# ---------------------------------------------------
# Scatto. I valori salvati in UCI sono gli indici delle scelte
# di gphoto2 (vedi iso_data.json ecc.), quindi si usa
# --set-config-index: con --set-config un indice come "1" verrebbe
# interpretato come etichetta (es. tempo di 1 secondo).
# ---------------------------------------------------
ISO_JSON=/www/luci-static/resources/webcam/iso_data.json
APERTURE_JSON=/www/luci-static/resources/webcam/aperture_data.json
SHUTTER_JSON=/www/luci-static/resources/webcam/shutterspeed_data.json

# Etichetta della scelta di gphoto2 con indice $2 nel file JSON $1
choice_label() {
	sed -n "s/.*\"value\": *\"$2\", *\"label\": *\"\([^\"]*\)\".*/\1/p" "$1" 2>/dev/null | head -n 1
}

# Un valore vuoto significa "non modificare": resta l'impostazione della
# fotocamera (utile in modalità P/Av/Tv). Il tempo "bulb" non è mai applicato
# perché con --capture-image-and-download lo scatto non termina.
shoot() {
	local iso="$1" aperture="$2" shutter="$3"

	set -- --set-config eosremoterelease=3 --set-config eosremoterelease=4
	[ -n "$iso" ] && set -- "$@" --set-config-index iso="$iso"
	[ -n "$aperture" ] && set -- "$@" --set-config-index aperture="$aperture"
	if [ -n "$shutter" ]; then
		if [ "$(choice_label "$SHUTTER_JSON" "$shutter")" = bulb ]; then
			log "Tempo di scatto 'bulb' ignorato: uso l'impostazione della fotocamera."
		else
			set -- "$@" --set-config-index shutterspeed="$shutter"
		fi
	fi

	gphoto2 "$@" \
		--capture-image-and-download \
		--force-overwrite \
		--filename "$FILENAME" >/dev/null 2>"$WORK_DIR/gphoto2.err"
}

# Spegne e riaccende la fotocamera tramite il relè della scheda e attende
# che torni visibile su USB (sblocca gli errori PTP/I-O).
camera_power_cycle() {
	local i
	log "Riavvio della fotocamera tramite la scheda."
	$SERIAL send c
	sleep 10
	$SERIAL send C
	for i in 1 2 3 4 5 6; do
		sleep 5
		gphoto2 --auto-detect 2>/dev/null | grep -q usb: && return 0
	done
	log "La fotocamera non è ricomparsa su USB dopo il riavvio."
	return 1
}

capture() {
	local rc

	if [ "$MODE" = day ]; then
		iso="$WC_ISO_DAY"; aperture="$WC_APERTURE_DAY"; shutter="$WC_SHUTTERSPEED_DAY"
	else
		iso="$WC_ISO_NIGHT"; aperture="$WC_APERTURE_NIGHT"; shutter="$WC_SHUTTERSPEED_NIGHT"
	fi

	rm -f "$WORK_DIR"/*.jpg "$WORK_DIR"/*.json 2>/dev/null

	# Spegne il riscaldamento durante lo scatto per avere abbastanza corrente
	touch "$CAPTURE_FLAG"
	if [ "$WC_HEATING" = 1 ] && [ "$(cat "$HEATER_STATE" 2>/dev/null)" = 1 ]; then
		$SERIAL send h
	fi

	shoot "$iso" "$aperture" "$shutter"
	rc=$?
	if [ "$rc" -ne 0 ] || [ ! -f "$FILENAME" ]; then
		log "Primo tentativo fallito: $(tail -n 3 "$WORK_DIR/gphoto2.err" | tr '\n' ' ')"
		camera_power_cycle
		shoot "$iso" "$aperture" "$shutter"
		rc=$?
	fi

	# Ripristina il riscaldamento (il controllo anti-appannamento potrebbe
	# averne cambiato lo stato desiderato nel frattempo)
	rm -f "$CAPTURE_FLAG"
	if [ "$WC_HEATING" = 1 ] && [ "$(cat "$HEATER_STATE" 2>/dev/null)" = 1 ]; then
		$SERIAL send H
	fi

	if [ "$rc" -ne 0 ] || [ ! -f "$FILENAME" ]; then
		fail "scatto fallito: $(tail -n 3 "$WORK_DIR/gphoto2.err" | tr '\n' ' ')"
	fi
}

# ---------------------------------------------------
# File di dati accanto alla foto: momento dello scatto, giorno/notte,
# impostazioni usate e ultimi valori di temperatura e umidità (da climate).
# Un valore null nelle impostazioni = lasciata quella della fotocamera.
# ---------------------------------------------------
write_datafile() {
	local climate="null" status="$WC_STATE_DIR/status.json"

	# Dati ambientali solo se recenti (climate gira ogni 5 minuti)
	if [ -s "$status" ] && [ $(( $(date +%s) - $(date -r "$status" +%s) )) -lt 900 ]; then
		climate="$(cat "$status")"
	fi

	cat > "$WORK_DIR/$DATAFILE" <<JSON
{
  "time": $NOW,
  "datetime": $(json_str "$(date -d "@$NOW" +%Y-%m-%dT%H:%M:%S%z)"),
  "camera": $(json_str "$WC_NAME"),
  "file": $(json_str "$FILENAME"),
  "mode": $(json_str "$MODE"),
  "special": $(json_str "$SPECIAL"),
  "settings": {
    "iso": $(json_str "$(choice_label "$ISO_JSON" "$iso")"),
    "aperture": $(json_str "$(choice_label "$APERTURE_JSON" "$aperture")"),
    "shutterspeed": $(json_str "$(choice_label "$SHUTTER_JSON" "$shutter")")
  },
  "day_start": $(json_num "$SUNRISE"),
  "day_end": $(json_num "$SUNSET"),
  "app_version": $(json_str "$(cat /usr/share/webcam/version 2>/dev/null)"),
  "climate": $climate
}
JSON
}

# ---------------------------------------------------
# Upload: ftp, ftps (FTP su TLS) o sftp
#
# Sul server:
#   <cartella>/[AAAA/MM/GG/]<prefisso>_AAAAMMGG-HHMM.jpg   archivio
#   <cartella>/[AAAA/MM/GG/]<prefisso>_AAAAMMGG-HHMM.json  dati (opzione)
#   <cartella>/current.jpg, current.json                  ultima foto (opzione)
# ---------------------------------------------------

# Carica il file locale $1 nel percorso remoto $2 (relativo alla cartella)
put_file() {
	local url port base

	port=""
	[ -n "$WC_UPLOAD_PORT" ] && port=":$WC_UPLOAD_PORT"

	set -- "$1" "$2" -s -S --connect-timeout 30 --retry 2 -T "$1" \
		--user "$WC_UPLOAD_USERNAME:$WC_UPLOAD_PASSWORD" --ftp-create-dirs

	case "$WC_UPLOAD_PROTOCOL" in
		ftps)
			# FTP esplicito su TLS: la connessione deve essere cifrata
			set -- "$@" --ssl-reqd
			[ "$WC_UPLOAD_INSECURE" = 1 ] && set -- "$@" --insecure
			base="ftp://$WC_UPLOAD_SERVER$port/"
			;;
		sftp)
			[ -n "$WC_UPLOAD_KEY" ] && set -- "$@" --key "$WC_UPLOAD_KEY"
			[ "$WC_UPLOAD_INSECURE" = 1 ] && set -- "$@" --insecure
			# "~/" = percorso relativo alla home dell'utente sul server
			base="sftp://$WC_UPLOAD_SERVER$port/~/"
			;;
		*)
			base="ftp://$WC_UPLOAD_SERVER$port/"
			;;
	esac

	url="$base$REMOTE_DIR$2"
	shift 2
	curl "$@" "$url"
}

upload() {
	local dir archive latest

	[ -n "$WC_UPLOAD_SERVER" ] || fail "server di upload non configurato"

	if [ "$WC_UPLOAD_PROTOCOL" = sftp ]; then
		curl -V 2>/dev/null | grep -q '^Protocols:.*sftp' || \
			fail "il curl installato non supporta SFTP (serve curl compilato con libssh2)"
	fi

	dir="${WC_UPLOAD_DIRECTORY#/}"
	dir="${dir%/}"
	[ -n "$dir" ] && dir="$dir/"
	REMOTE_DIR="$dir"

	archive=""
	[ "$WC_UPLOAD_DATE_DIRS" = 1 ] && archive="$(date -d "@$NOW" +%Y/%m/%d)/"

	[ "$WC_UPLOAD_DATA" = 1 ] && write_datafile

	put_file "$FILENAME" "$archive$FILENAME" || \
		fail "upload fallito verso $WC_UPLOAD_PROTOCOL://$WC_UPLOAD_SERVER/$dir$archive"

	if [ "$WC_UPLOAD_DATA" = 1 ]; then
		put_file "$DATAFILE" "$archive$DATAFILE" || \
			log "ATTENZIONE: upload del file di dati $DATAFILE fallito"
	fi

	log "Upload completato: $archive$FILENAME ($MODE${SPECIAL:+, $SPECIAL}, $WC_UPLOAD_PROTOCOL)"

	# Copia dell'ultima foto con nome fisso, per pagine web e incorporamenti
	if [ "$WC_UPLOAD_LATEST" = 1 ]; then
		latest="$WC_UPLOAD_LATEST_NAME"
		case "$latest" in
			''|*[!A-Za-z0-9._-]*) latest=current ;;
		esac
		latest="${latest%.jpg}"
		if put_file "$FILENAME" "$latest.jpg"; then
			[ "$WC_UPLOAD_DATA" = 1 ] && { put_file "$DATAFILE" "$latest.json" || \
				log "ATTENZIONE: upload di $latest.json fallito"; }
		else
			log "ATTENZIONE: upload della copia $latest.jpg fallito"
			write_status "ok, ma copia $latest.jpg non caricata"
			return
		fi
	fi

	write_status ok
}

write_status running
day_or_night
capture
if [ "$NO_UPLOAD" = 1 ]; then
	log "Scatto di prova senza upload: $FILENAME ($MODE)"
	write_status test
else
	upload
	ping_monitor ok "foto $FILENAME caricata ($MODE${SPECIAL:+, $SPECIAL})"
fi
exit 0
