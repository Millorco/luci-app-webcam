#!/bin/sh
# ---------------------------------------------------
#
# Scatto con fotocamera Canon EOS tramite gphoto2 e upload della foto
# al portal (HTTPS) e/o al server FTP/FTPS/SFTP
#
# Uso: capture [--no-upload]
#   --no-upload  scatto di prova: la foto resta solo sul router
#                (anteprima nella pagina Status), niente upload
#
# ---------------------------------------------------

. /usr/bin/webcam.cfg
. /usr/libexec/webcam/common.sh

SERIAL=/usr/libexec/webcam/serial
PING=/usr/libexec/webcam/hc_ping
CAPTURE_FLAG="$WC_STATE_DIR/capturing"
HEATER_STATE="$WC_STATE_DIR/heater"
CAPTURE_JSON="$WC_STATE_DIR/capture.json"
WORK_DIR=/tmp/webcam/photo
LOCK_DIR=/var/lock/webcam_capture.lock
LOCK_STALE=900        # un lock più vecchio di così è considerato orfano
CAMERA_POWER="$WC_STATE_DIR/camera_power"   # 0 = relè della fotocamera spento
CAMERA_INFO_EVERY=3600   # modello, serie, contatore: letti al massimo ogni ora

NO_UPLOAD=0
case "$1" in
	--no-upload) NO_UPLOAD=1 ;;
	'') ;;
	*) echo "Uso: $0 [--no-upload]" >&2; exit 2 ;;
esac

mkdir -p "$WORK_DIR"
cd "$WORK_DIR" || exit 1

# Un solo scatto alla volta: il pulsante "Scatta ora" di LuCI e il
# servizio potrebbero partire insieme e contendersi la fotocamera.
take_lock() {
	mkdir "$LOCK_DIR" 2>/dev/null && return 0
	# Lock rimasto da uno scatto terminato in modo anomalo
	if [ $(( $(date +%s) - $(date -r "$LOCK_DIR" +%s 2>/dev/null || echo 0) )) -gt "$LOCK_STALE" ]; then
		rmdir "$LOCK_DIR" 2>/dev/null
		mkdir "$LOCK_DIR" 2>/dev/null && return 0
	fi
	return 1
}
if ! take_lock; then
	logger -p user.warning -t "$WC_NAME capture" "ATTENZIONE: uno scatto è già in corso, questo viene saltato."
	[ -t 2 ] && echo "Uno scatto è già in corso." >&2
	exit 3
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT
trap 'exit 1' INT TERM

# Un solo istante di riferimento per nome file, cartelle e dati
NOW=$(date +%s)
NOW_DATE="$(date -d "@$NOW" +"%Y%m%d-%H%M")"
FILENAME="${WC_PHOTO_NAME}_${NOW_DATE}.jpg"
DATAFILE="${FILENAME%.jpg}.json"
MODE=""
QUEUED=""
SUNRISE=""
SUNSET=""
# Nome della fascia oraria speciale attiva (impostato da capture_service)
SPECIAL="${WC_SPECIAL:-}"
# Ora sincronizzata con NTP al momento dello scatto (photo/1)
TIME_SYNCED="$(wc_time_synced)"
# Destinazione: portal, ftp o both
TARGET="$(wc_upload_target)"
ATTEMPTS=1
CYCLED=false
DURATION=""
PORTAL_RESULT=""

# Sul terminale solo se lanciato a mano: sotto procd lo stderr finirebbe
# nel syslog come "sh" a livello err, doppione della riga di logger.
# Livello syslog dal prefisso del messaggio, così in VictoriaLogs gli
# errori sono rossi, gli avvisi gialli e le foto caricate verdi.
log_prio() {
	case "$1" in
		ERRORE*) echo user.err ;;
		ATTENZIONE*) echo user.warning ;;
		OK*) echo user.info ;;
		*) echo user.notice ;;
	esac
}

log() {
	[ -t 2 ] && echo "$@" >&2
	logger -p "$(log_prio "$*")" -t "$WC_NAME capture" "$@"
}

# json_str, json_num e le altre funzioni JSON sono in common.sh

write_status() {
	cat > "$CAPTURE_JSON.tmp" <<JSON
{
  "time": $(date +%s),
  "mode": $(json_str "$MODE"),
  "special": $(json_str "$SPECIAL"),
  "file": $(json_str "$FILENAME"),
  "upload": $( [ "$NO_UPLOAD" = 1 ] && echo false || echo true ),
  "queued": $(json_num "$QUEUED"),
  "target": $(json_str "$TARGET"),
  "portal": $(json_str "$PORTAL_RESULT"),
  "time_synced": $TIME_SYNCED,
  "result": $(json_str "$1")
}
JSON
	mv "$CAPTURE_JSON.tmp" "$CAPTURE_JSON"
}

# Ping al servizio di monitoraggio (Uptime Kuma o healthchecks.io), in background per non
# ritardare lo scatto. Gli scatti di prova senza upload non contano.
ping_monitor() {
	[ "$NO_UPLOAD" = 1 ] && return
	"$PING" "$1" "$WC_NAME: $2" </dev/null >/dev/null 2>&1 &
}

fail() {
	log "ERRORE: $1"
	write_status "$1"
	ping_monitor fail "$1"
	exit 1
}

# ---------------------------------------------------
# Giorno o notte? Alba e tramonto sono calcolati in locale
# dalle coordinate, senza dipendere da servizi esterni.
# Gli scostamenti (minuti, anche negativi) spostano il passaggio:
# es. alba -30 e tramonto +30 usano le impostazioni diurne da mezz'ora
# prima dell'alba a mezz'ora dopo il tramonto, quando il cielo è ancora chiaro.
# Imposta MODE, SUNRISE e SUNSET (inizio e fine delle impostazioni diurne).
# ---------------------------------------------------
offset_minutes() {
	case "$1" in
		''|-|*[!0-9-]*|?*-*) echo 0 ;;
		*) echo "$1" ;;
	esac
}

day_or_night() {
	local sun

	MODE=day
	if [ -z "$WC_LATITUDE" ] || [ -z "$WC_LONGITUDE" ]; then
		log "Coordinate non impostate: uso le impostazioni diurne."
		return
	fi

	sun=$(/usr/libexec/webcam/sun_times "$WC_LATITUDE" "$WC_LONGITUDE" "$NOW")
	case "$sun" in
		polar_day)   MODE=day;   return ;;
		polar_night) MODE=night; return ;;
	esac

	SUNRISE=${sun% *}
	SUNSET=${sun#* }
	case "$SUNRISE$SUNSET" in
		''|*[!0-9]*)
			log "Calcolo alba/tramonto fallito ('$sun'): uso le impostazioni diurne."
			SUNRISE=""; SUNSET=""
			return
			;;
	esac

	SUNRISE=$(( SUNRISE + $(offset_minutes "$WC_SUNRISE_OFFSET") * 60 ))
	SUNSET=$(( SUNSET + $(offset_minutes "$WC_SUNSET_OFFSET") * 60 ))

	if [ "$NOW" -ge "$SUNRISE" ] && [ "$NOW" -lt "$SUNSET" ]; then
		MODE=day
	else
		MODE=night
	fi
}

# ---------------------------------------------------
# Scatto. I valori salvati in UCI sono gli indici delle scelte
# di gphoto2 (vedi iso_data.json ecc.), quindi si usa
# --set-config-index: con --set-config un indice come "1" verrebbe
# interpretato come etichetta (es. tempo di 1 secondo).
# ---------------------------------------------------
ISO_JSON=/www/luci-static/resources/webcam/iso_data.json
APERTURE_JSON=/www/luci-static/resources/webcam/aperture_data.json
SHUTTER_JSON=/www/luci-static/resources/webcam/shutterspeed_data.json

# Etichetta della scelta di gphoto2 con indice $2 nel file JSON $1
choice_label() {
	sed -n "s/.*\"value\": *\"$2\", *\"label\": *\"\([^\"]*\)\".*/\1/p" "$1" 2>/dev/null | head -n 1
}

# Un valore vuoto significa "non modificare": resta l'impostazione della
# fotocamera (utile in modalità P/Av/Tv). Il tempo "bulb" non è mai applicato
# perché con --capture-image-and-download lo scatto non termina.
shoot() {
	local iso="$1" aperture="$2" shutter="$3"

	set -- --set-config eosremoterelease=3 --set-config eosremoterelease=4
	[ -n "$iso" ] && set -- "$@" --set-config-index iso="$iso"
	[ -n "$aperture" ] && set -- "$@" --set-config-index aperture="$aperture"
	if [ -n "$shutter" ]; then
		if [ "$(choice_label "$SHUTTER_JSON" "$shutter")" = bulb ]; then
			log "Tempo di scatto 'bulb' ignorato: uso l'impostazione della fotocamera."
		else
			set -- "$@" --set-config-index shutterspeed="$shutter"
		fi
	fi

	gphoto2 "$@" \
		--capture-image-and-download \
		--force-overwrite \
		--filename "$FILENAME" >/dev/null 2>"$WORK_DIR/gphoto2.err"
}

# Spegne e riaccende la fotocamera tramite il relè della scheda e attende
# che torni visibile su USB (sblocca gli errori PTP/I-O).
camera_power_cycle() {
	local i
	log "Riavvio della fotocamera tramite la scheda."
	CYCLED=true
	echo 0 > "$CAMERA_POWER"
	$SERIAL send c
	sleep 10
	$SERIAL send C
	echo 1 > "$CAMERA_POWER"
	counter_add power_cycles
	for i in 1 2 3 4 5 6; do
		sleep 5
		gphoto2 --auto-detect 2>/dev/null | grep -q usb: && return 0
	done
	log "ERRORE: la fotocamera non è ricomparsa su USB dopo il riavvio dalla scheda."
	return 1
}

# Causa leggibile dell'ultimo errore di gphoto2, seguita dal testo originale
gphoto_reason() {
	local err cause

	err="$(tail -n 3 "$WORK_DIR/gphoto2.err" 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g; s/ $//')"
	case "$err" in
		*"Could not detect any camera"*|*"No camera found"*|*"Unknown model"*)
			cause="fotocamera non trovata su USB (spenta, cavo scollegato o batteria scarica)" ;;
		*"Could not claim the USB device"*|*"Could not lock the device"*)
			cause="USB della fotocamera occupata da un altro processo" ;;
		*"Out of Focus"*|*"focus"*|*"Focus"*)
			cause="messa a fuoco non riuscita (autofocus attivo con poca luce o nebbia?)" ;;
		*"No space"*|*"Card"*|*"card"*|*"Storage"*|*"storage"*)
			cause="problema con la scheda di memoria della fotocamera (piena, assente o protetta)" ;;
		*"I/O"*|*"PTP"*|*"timeout"*|*"Timeout"*)
			cause="errore di comunicazione USB con la fotocamera" ;;
		*"Bad parameters"*|*"Bad file descriptor"*|*"Unsupported"*)
			cause="impostazione non accettata dalla fotocamera (ghiera su M? ISO, diaframma o tempo fuori gamma?)" ;;
		'')
			cause="la fotocamera non ha restituito nessun file" ;;
		*)
			cause="errore della fotocamera" ;;
	esac
	[ -n "$err" ] && cause="$cause - gphoto2: $err"
	echo "$cause"
}

# Spazio libero in KB nella cartella $1
free_kb() {
	df -Pk "$1" 2>/dev/null | awk 'NR == 2 { print $4 }'
}

camera_present() {
	gphoto2 --auto-detect 2>/dev/null | grep -q usb:
}

capture() {
	local rc free

	if [ "$MODE" = day ]; then
		iso="$WC_ISO_DAY"; aperture="$WC_APERTURE_DAY"; shutter="$WC_SHUTTERSPEED_DAY"
	else
		iso="$WC_ISO_NIGHT"; aperture="$WC_APERTURE_NIGHT"; shutter="$WC_SHUTTERSPEED_NIGHT"
	fi

	rm -f "$WORK_DIR"/*.jpg "$WORK_DIR"/*.json 2>/dev/null

	# Una foto RAW+JPEG grande può superare i 30 MB: con /tmp (RAM) pieno
	# gphoto2 fallirebbe con un errore poco chiaro
	free=$(free_kb "$WORK_DIR")
	if [ -n "$free" ] && [ "$free" -lt 10240 ]; then
		fail "memoria del router quasi piena: in $WORK_DIR restano ${free} KB (la coda di upload in /tmp è troppo grande?)"
	fi

	if ! camera_present; then
		log "ERRORE: fotocamera non trovata su USB, provo a riaccenderla dalla scheda."
		if ! camera_power_cycle; then
			counter_add capture_errors
			wc_event camera.missing error "Fotocamera non trovata su USB anche dopo il riavvio dalla scheda" \
				"{\"file\":$(json_str "$FILENAME")}"
			fail "fotocamera non trovata su USB anche dopo il riavvio dalla scheda: controlla alimentazione, cavo USB e che sia accesa"
		fi
	fi

	# Spegne il riscaldamento durante lo scatto per avere abbastanza corrente
	touch "$CAPTURE_FLAG"
	if [ "$WC_HEATING" = 1 ] && [ "$(cat "$HEATER_STATE" 2>/dev/null)" = 1 ]; then
		$SERIAL send h
	fi

	t0=$(date +%s)
	shoot "$iso" "$aperture" "$shutter"
	rc=$?
	if [ "$rc" -ne 0 ] || [ ! -f "$FILENAME" ]; then
		reason="$(gphoto_reason)"
		log "ATTENZIONE: primo tentativo di scatto fallito ($reason), riavvio la fotocamera e riprovo."
		wc_event camera.power_cycle warning "primo tentativo di scatto fallito ($reason), riavvio la fotocamera e riprovo" \
			"{\"file\":$(json_str "$FILENAME"),\"gphoto2\":$(json_str "$(tail -n 3 "$WORK_DIR/gphoto2.err" 2>/dev/null | cut -c1-300)")}"
		ATTEMPTS=2
		camera_power_cycle
		shoot "$iso" "$aperture" "$shutter"
		rc=$?
	fi

	# Ripristina il riscaldamento (il controllo anti-appannamento potrebbe
	# averne cambiato lo stato desiderato nel frattempo)
	rm -f "$CAPTURE_FLAG"
	if [ "$WC_HEATING" = 1 ] && [ "$(cat "$HEATER_STATE" 2>/dev/null)" = 1 ]; then
		$SERIAL send H
	fi

	DURATION=$(( $(date +%s) - t0 ))

	if [ "$rc" -ne 0 ] || [ ! -f "$FILENAME" ]; then
		reason="$(gphoto_reason)"
		counter_add capture_errors
		wc_event camera.error error "Scatto fallito dopo il riavvio della fotocamera: $reason" \
			"{\"file\":$(json_str "$FILENAME"),\"reason\":$(json_str "$reason"),\"gphoto2\":$(json_str "$(tail -n 3 "$WORK_DIR/gphoto2.err" 2>/dev/null | cut -c1-300)")}"
		fail "scatto fallito dopo il riavvio della fotocamera: $reason"
	fi
}

# ---------------------------------------------------
# Fotocamera: modello, numero di serie, firmware, obiettivo, contatore
# degli scatti (se la fotocamera lo espone, molte EOS entry level no) e
# batteria. --list-all-config allunga lo scatto di qualche secondo, quindi
# si legge al massimo una volta l'ora; il JSON ripete l'ultimo valore.
# ---------------------------------------------------
read_camera_info() {
	local age kv model serial fw lens count batt change

	if [ -s "$WC_CAMERA_INFO" ]; then
		age=$(( $(date +%s) - $(date -r "$WC_CAMERA_INFO" +%s 2>/dev/null || echo 0) ))
		[ "$age" -ge 0 ] && [ "$age" -lt "$CAMERA_INFO_EVERY" ] && return 0
	fi

	kv="$WORK_DIR/camera.kv"
	wc_timeout 60 gphoto2 --list-all-config 2>/dev/null | awk '
		/^\// { n = $0; sub(/.*\//, "", n); next }
		/^Current: / && n != "" { if (!(n in seen)) { seen[n] = 1; print n "=" substr($0, 10) } }' > "$kv"
	val() { sed -n "s/^$1=//p" "$kv" | head -n 1 | sed 's/[[:space:]]*$//'; }
	model="$(val cameramodel)"; [ -n "$model" ] || model="$(val model)"
	serial="$(val eosserialnumber)"; [ -n "$serial" ] || serial="$(val serialnumber)"
	fw="$(val deviceversion)"; [ -n "$fw" ] || fw="$(val firmwareversion)"
	lens="$(val lensname)"
	count="$(val shuttercounter)"
	batt="$(val batterylevel)"
	rm -f "$kv"
	# Numero di serie tutto a zeri: non letto
	case "$serial" in ''|*[!0]*) ;; *) serial="" ;; esac
	[ -n "$model$serial" ] || return 1

	cat > "$WC_CAMERA_INFO.tmp" <<JSON
{"model":$(json_str "$(printf '%s' "$model" | cut -c1-150)"),"serial":$(json_str "$(printf '%s' "$serial" | cut -c1-64)"),"firmware":$(json_str "$(printf '%s' "$fw" | cut -c1-32)"),"lens":$(json_str "$(printf '%s' "$lens" | cut -c1-100)"),"shutter_count":$(json_int "$count"),"battery_level":$(json_str "$(printf '%s' "$batt" | cut -c1-16)"),"read_at":$(date +%s)}
JSON
	mv "$WC_CAMERA_INFO.tmp" "$WC_CAMERA_INFO"

	# Fotocamera cambiata: i contatori ripartono da 0
	change="$(counters_camera "$model" "$serial")"
	if [ -n "$change" ]; then
		log "Fotocamera cambiata: $change (contatori azzerati)."
		wc_event camera.change notice "Fotocamera cambiata: $change" \
			"{\"from\":$(json_str "${change% -> *}"),\"to\":$(json_str "${change#* -> }")}"
	fi
	return 0
}

# Dopo uno scatto riuscito: contatori e dati della fotocamera
after_shot() {
	read_camera_info
	counter_add shots_total
}

# ---------------------------------------------------
# File di dati accanto alla foto: momento dello scatto, giorno/notte,
# impostazioni usate e ultimi valori di temperatura e umidità (da climate).
# Un valore null nelle impostazioni = lasciata quella della fotocamera.
# ---------------------------------------------------
write_datafile() {
	local climate="null" status="$WC_STATE_DIR/status.json" power="null" info="null" sha size

	# Dati ambientali solo se recenti (climate gira ogni 5 minuti)
	if [ -s "$status" ] && [ $(( $(date +%s) - $(date -r "$status" +%s) )) -lt 900 ]; then
		climate="$(sed 's/^[[:space:]]*//' "$status" | tr -d '\n')"
	fi
	# Ultimo campione Victron, se recente
	[ "$WC_VICTRON" = 1 ] && power="$(wc_json_fresh "$WC_VICTRON_JSON" 900 || echo null)"
	[ -s "$WC_CAMERA_INFO" ] && info="$(tr -d '\n' < "$WC_CAMERA_INFO")"

	# SHA-256 e dimensione del JPEG, calcolati dopo lo scatto e prima del
	# JSON: identificano la foto sul portal (idempotenza e certificazione)
	sha="$(sha256sum "$WORK_DIR/$FILENAME" | cut -d' ' -f1)"
	size="$(wc -c < "$WORK_DIR/$FILENAME" | tr -d ' ')"

	# photo/1: i campi di photo/0 restano tutti con lo stesso nome
	cat > "$WORK_DIR/$DATAFILE" <<JSON
{
  "schema": "photo/1",
  "time": $NOW,
  "datetime": $(json_str "$(date -d "@$NOW" +%Y-%m-%dT%H:%M:%S%z)"),
  "time_synced": $TIME_SYNCED,
  "mac": $(json_str "$(get_mac)"),
  "hostname": $(json_str "$WC_NAME"),
  "camera": $(json_str "$WC_NAME"),
  "file": $(json_str "$FILENAME"),
  "sha256": $(json_str "$sha"),
  "size": $(json_num "$size"),
  "mode": $(json_str "$MODE"),
  "special": $(json_str "$SPECIAL"),
  "interval": $(json_num "$WC_INTERVAL"),
  "settings": {
    "iso": $(json_str "$(choice_label "$ISO_JSON" "$iso")"),
    "aperture": $(json_str "$(choice_label "$APERTURE_JSON" "$aperture")"),
    "shutterspeed": $(json_str "$(choice_label "$SHUTTER_JSON" "$shutter")")
  },
  "day_start": $(json_num "$SUNRISE"),
  "day_end": $(json_num "$SUNSET"),
  "lat": $(json_dec "$WC_LATITUDE"),
  "lon": $(json_dec "$WC_LONGITUDE"),
  "app_version": $(json_str "$(wc_app_version)"),
  "board_fw": $(json_str "$(wc_board_fw)"),
  "capture": { "attempts": $ATTEMPTS, "camera_power_cycled": $CYCLED, "duration_s": $(json_num "$DURATION") },
  "camera_info": $info,
  "climate": $climate,
  "power": $power
}
JSON
}

# ---------------------------------------------------
# Upload: ftp, ftps (FTP su TLS) o sftp
#
# Sul server:
#   <cartella>/[AAAA/MM/GG/]<prefisso>_AAAAMMGG-HHMM.jpg   archivio
#   <cartella>/[AAAA/MM/GG/]<prefisso>_AAAAMMGG-HHMM.json  dati (opzione)
#   <cartella>/current.jpg, current.json                  ultima foto (opzione)
# ---------------------------------------------------

# Carica il file locale $1 nel percorso remoto $2 (relativo alla cartella).
# Con $3 = atomic il file viaggia con un nome temporaneo e viene rinominato
# solo a upload completato: chi apre current.jpg durante l'upload vede
# ancora la foto precedente, mai un'immagine troncata.
put_file() {
	local local_file="$1" remote="$2" mode="$3" url port base tmp

	port=""
	[ -n "$WC_UPLOAD_PORT" ] && port=":$WC_UPLOAD_PORT"

	tmp="$remote"
	[ "$mode" = atomic ] && tmp="$remote.part"

	set -- -s -S --connect-timeout 30 --retry 2 -T "$local_file" \
		--user "$WC_UPLOAD_USERNAME:$WC_UPLOAD_PASSWORD" --ftp-create-dirs

	case "$WC_UPLOAD_PROTOCOL" in
		ftps)
			# FTP esplicito su TLS: la connessione deve essere cifrata
			set -- "$@" --ssl-reqd
			[ "$WC_UPLOAD_INSECURE" = 1 ] && set -- "$@" --insecure
			base="ftp://$WC_UPLOAD_SERVER$port/"
			;;
		sftp)
			[ -n "$WC_UPLOAD_KEY" ] && set -- "$@" --key "$WC_UPLOAD_KEY"
			[ "$WC_UPLOAD_INSECURE" = 1 ] && set -- "$@" --insecure
			# "~/" = percorso relativo alla home dell'utente sul server
			base="sftp://$WC_UPLOAD_SERVER$port/~/"
			;;
		*)
			base="ftp://$WC_UPLOAD_SERVER$port/"
			;;
	esac

	# Comandi eseguiti dopo il trasferimento ("-"). Il vecchio file viene
	# cancellato prima ("*" = va bene anche se non esiste) perché molti
	# server SFTP, OpenSSH compreso, rifiutano di rinominare sopra un file
	# esistente. In FTP curl entra nella cartella del file, quindi bastano
	# i nomi; in SFTP i percorsi sono relativi alla home, come "~/" sopra.
	if [ "$mode" = atomic ]; then
		if [ "$WC_UPLOAD_PROTOCOL" = sftp ]; then
			set -- "$@" -Q "-*rm \"$REMOTE_DIR$remote\"" \
				-Q "-rename \"$REMOTE_DIR$tmp\" \"$REMOTE_DIR$remote\""
		else
			set -- "$@" -Q "-*DELE ${remote##*/}" \
				-Q "-RNFR ${tmp##*/}" -Q "-RNTO ${remote##*/}"
		fi
	fi

	url="$base$REMOTE_DIR$tmp"
	# L'errore di curl va in un file: sotto procd finirebbe nel syslog
	# come "sh" a livello err, senza dire di quale foto si tratta
	curl "$@" "$url" 2>"$WORK_DIR/curl.err"
}

# Causa leggibile dell'ultimo upload fallito: prima la rete, poi curl
upload_reason() {
	local err

	err="$(tail -n 2 "$WORK_DIR/curl.err" 2>/dev/null | tr '\n' ' ' | sed 's/^curl: //; s/  */ /g; s/ $//')"
	if ! ip route show default 2>/dev/null | grep -q .; then
		echo "rete giù: il router non ha una route predefinita (4G/WAN scollegata?)${err:+ - curl: $err}"
		return
	fi
	case "$WC_UPLOAD_SERVER" in
		*[!0-9.]*) ;;   # nome: si controlla il DNS
		*) set -- ip ;; # indirizzo IP: niente da risolvere
	esac
	if [ "$1" != ip ] && ! nslookup "$WC_UPLOAD_SERVER" >/dev/null 2>&1; then
		echo "il nome $WC_UPLOAD_SERVER non si risolve (DNS o connessione internet assente)${err:+ - curl: $err}"
		return
	fi
	case "$err" in
		*"Login denied"*|*"Access denied"*|*"530"*|*"Authentication failure"*|*"authentication"*)
			echo "credenziali di upload rifiutate dal server - curl: $err" ;;
		*"Connection refused"*|*"Failed to connect"*|*"Couldn't connect"*)
			echo "server di upload non raggiungibile (servizio spento o porta chiusa) - curl: $err" ;;
		*"timed out"*|*"Timeout"*)
			echo "il server di upload non risponde in tempo (connessione lenta?) - curl: $err" ;;
		*"certificate"*|*"SSL"*|*"TLS"*)
			echo "problema con il certificato TLS del server - curl: $err" ;;
		*"Quota"*|*"quota"*|*"552"*|*"Disk full"*|*"No space"*)
			echo "spazio esaurito sul server di upload - curl: $err" ;;
		*"550"*|*"Permission denied"*|*"Access to"*)
			echo "permessi mancanti sulla cartella remota - curl: $err" ;;
		'') echo "motivo sconosciuto" ;;
		*) echo "curl: $err" ;;
	esac
}

# ---------------------------------------------------
# Coda offline. Ogni foto da caricare viene messa in coda prima
# dell'upload e tolta solo quando è arrivata a destinazione; se l'upload
# fallisce (4G assente, server giù) resta lì e viene ritentata ai giri
# successivi, dopo la foto nuova.
#   <coda>/[AAAA/MM/GG/]foto.jpg + .json   per l'FTP: rispecchia le cartelle
#                                          remote, così ogni foto finisce
#                                          nella cartella del suo giorno
#   <coda>/portal/foto.jpg + .json         per il portal
#   <coda>/rejected/                       foto rifiutate dal portal (400,
#                                          413, 415, 422 ripetuto), al
#                                          massimo 20, da guardare via SSH
# In /tmp (RAM) la coda usa collegamenti fisici alla foto appena
# scattata, quindi non occupa spazio in più finché quella resta sul router,
# anche quando la stessa foto aspetta sia il portal sia l'FTP.
# ---------------------------------------------------
QUEUE_DIR=/tmp/webcam/queue
QUEUE_RESERVE_KB=8192   # spazio da lasciare comunque libero nel filesystem
REJECTED_MAX=20

setup_queue() {
	case "$WC_QUEUE_SIZE" in
		''|*[!0-9]*) WC_QUEUE_SIZE=20 ;;
	esac
	if [ -n "$WC_QUEUE_DIR" ]; then
		# Su chiavetta USB: la cartella deve esistere già, altrimenti con la
		# chiavetta non montata la coda finirebbe nella flash del router.
		if [ -d "$WC_QUEUE_DIR" ]; then
			QUEUE_DIR="${WC_QUEUE_DIR%/}"
		else
			log "ERRORE: cartella della coda $WC_QUEUE_DIR non trovata (chiavetta USB non montata o guasta?), uso $QUEUE_DIR in RAM."
		fi
	fi
	PORTAL_QUEUE="$QUEUE_DIR/portal"
	REJECTED_DIR="$QUEUE_DIR/rejected"
	[ "$WC_QUEUE_SIZE" -gt 0 ] && mkdir -p "$QUEUE_DIR"
}

queue_enabled() {
	[ "$WC_QUEUE_SIZE" -gt 0 ] && [ -d "$QUEUE_DIR" ]
}

# Ordina per la parte finale del nome, AAAAMMGG-HHMM.jpg, che non dipende
# dal prefisso scelto in LuCI
sort_photos() {
	awk '{ n = $0; sub(/.*\//, "", n); print substr(n, length(n) - 16) "\t" $0 }' | \
		sort | cut -f 2-
}

# Foto in coda per l'FTP, dalla più vecchia (senza le sottocartelle del
# portal, delle foto rifiutate, della telemetria e degli eventi)
queue_list() {
	queue_enabled || return 0
	find "$QUEUE_DIR" \( -path "$QUEUE_DIR/portal" -o -path "$QUEUE_DIR/rejected" \
		-o -path "$QUEUE_DIR/telemetry" -o -path "$QUEUE_DIR/events" \) -prune \
		-o -type f -name '*.jpg' -print 2>/dev/null | sort_photos
}

# Foto in coda per il portal, dalla più vecchia
portal_queue_list() {
	queue_enabled || return 0
	[ -d "$PORTAL_QUEUE" ] || return 0
	find "$PORTAL_QUEUE" -maxdepth 1 -type f -name '*.jpg' 2>/dev/null | sort_photos
}

# Tutte le foto in coda (FTP e portal), dalla più vecchia
queue_list_all() {
	{ queue_list; portal_queue_list; } | sort_photos
}

# Foto diverse in attesa: una foto che aspetta FTP e portal conta una volta
queue_count() {
	queue_list_all | sed 's:.*/::' | sort -u | grep -c .
}

# Aggiunge alla coda la foto $1 (e il .json accanto) nel percorso $2
# relativo a $3 (predefinito: la coda dell'FTP)
queue_add() {
	local src="$1" rel="$2" base="${3:-$QUEUE_DIR}" dst

	queue_enabled || return 0
	dst="$base/$rel"
	mkdir -p "${dst%/*}"
	ln -f "$src" "$dst" 2>/dev/null || cp "$src" "$dst" || return 1
	if [ -f "${src%.jpg}.json" ]; then
		ln -f "${src%.jpg}.json" "${dst%.jpg}.json" 2>/dev/null || \
			cp "${src%.jpg}.json" "${dst%.jpg}.json"
	fi
	return 0
}

# Toglie dalla coda il file $1 (percorso locale nella coda) e il suo .json,
# poi le cartelle rimaste vuote
queue_remove() {
	local f="$1" d

	rm -f "$f" "${f%.jpg}.json" "$f.422"
	d="${f%/*}"
	while [ "$d" != "$QUEUE_DIR" ] && [ "${d#"$QUEUE_DIR"/}" != "$d" ]; do
		rmdir "$d" 2>/dev/null || break
		d="${d%/*}"
	done
}

queue_free_kb() {
	free_kb "$QUEUE_DIR"
}

# Rispetta il limite in MB e lascia libero lo spazio di riserva: prima
# cancella le foto rifiutate, poi le più vecchie in coda (da tutte le
# destinazioni). La foto più recente resta sempre.
queue_prune() {
	local used free oldest name f dropped=0

	queue_enabled || return 0
	while :; do
		used=$(du -sk "$QUEUE_DIR" 2>/dev/null | awk '{ print $1 }')
		free=$(queue_free_kb)
		[ "${used:-0}" -le $(( WC_QUEUE_SIZE * 1024 )) ] && \
			[ "${free:-0}" -ge "$QUEUE_RESERVE_KB" ] && break
		oldest="$(find "$REJECTED_DIR" -type f -name '*.jpg' 2>/dev/null | sort_photos | head -n 1)"
		if [ -n "$oldest" ]; then
			rm -f "$oldest" "${oldest%.jpg}.json" "${oldest%.jpg}.txt"
			continue
		fi
		[ "$(queue_count)" -gt 1 ] || break
		name="$(queue_list_all | head -n 1)"
		name="${name##*/}"
		for f in $(queue_list_all | grep "/$name\$"); do
			queue_remove "$f"
		done
		dropped=$(( dropped + 1 ))
	done
	if [ "$dropped" -gt 0 ]; then
		log "ATTENZIONE: coda di upload piena, cancellate $dropped foto non caricate (le più vecchie)."
		wc_event queue.dropped error "Coda di upload piena: cancellate $dropped foto non caricate" "{\"count\":$dropped}"
	fi
	return 0
}

# Tempo per svuotare le code: metà intervallo, al massimo 5 minuti, così
# il prossimo scatto non slitta (diviso tra portal e FTP se sono due)
drain_budget() {
	local budget=300
	case "$WC_INTERVAL" in
		''|*[!0-9]*) ;;
		*) [ $(( WC_INTERVAL * 30 )) -lt "$budget" ] && budget=$(( WC_INTERVAL * 30 )) ;;
	esac
	[ "$TARGET" = both ] && budget=$(( budget / 2 ))
	echo "$budget"
}

# ---------------------------------------------------
# Upload al portal: POST /api/v1/photo, multipart con la foto e il suo
# JSON photo/1 (vedi il contratto, api-portal-v1.md). La foto è
# riconosciuta dallo SHA-256: un secondo invio della stessa foto non la
# duplica, quindi riprovare è sempre sicuro.
# ---------------------------------------------------
PORTAL_REASON=""

# Sposta una foto della coda del portal in rejected/, con il motivo
portal_reject() {
	local f="$1" why="$2" name old

	name="${f##*/}"
	mkdir -p "$REJECTED_DIR"
	mv -f "$f" "$REJECTED_DIR/$name" 2>/dev/null
	[ -f "${f%.jpg}.json" ] && mv -f "${f%.jpg}.json" "$REJECTED_DIR/${name%.jpg}.json"
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$why" > "$REJECTED_DIR/${name%.jpg}.txt"
	rm -f "$f.422"
	while [ "$(find "$REJECTED_DIR" -type f -name '*.jpg' | grep -c .)" -gt "$REJECTED_MAX" ]; do
		old="$(find "$REJECTED_DIR" -type f -name '*.jpg' | sort_photos | head -n 1)"
		rm -f "$old" "${old%.jpg}.json" "${old%.jpg}.txt"
	done
}

# Manda la foto $1 (con il .json accanto). $2 = 1 se è la foto nuova
# (aggiorna current.jpg), 0 se arriva dalla coda.
# Ritorna 0 inviata, 1 da riprovare più tardi (coda ferma), 2 rifiutata.
portal_send() {
	local jpg="$1" current="$2" json="${1%.jpg}.json" resp code wait

	resp="$WORK_DIR/portal.resp"
	wait="$(wc_portal_wait_left)"
	if [ "$wait" -gt 0 ]; then
		PORTAL_REASON="il portal ha chiesto di aspettare ancora $wait s (HTTP 429)"
		return 1
	fi
	if [ ! -f "$json" ]; then
		PORTAL_REASON="manca il file di dati ${json##*/}"
		return 2
	fi

	code="$(wc_portal_call /api/v1/photo "$resp" -m 300 --retry 2 \
		-F "photo=@$jpg;type=image/jpeg" \
		-F "meta=@$json;type=application/json" \
		-F "current=$current")"
	PORTAL_REASON="$(wc_portal_reason "$code" "$resp")"
	case "$code" in
		200|201)
			[ "$(wc_jget "$resp" duplicate)" = true ] && PORTAL_REASON="già ricevuta" || PORTAL_REASON=""
			return 0
			;;
		400|413|415)
			return 2
			;;
		422)
			# Un solo nuovo tentativo (upload troncato?), poi rejected/.
			# Per la foto nuova il segno va sulla sua copia in coda.
			[ "$current" = 1 ] && jpg="$PORTAL_QUEUE/${jpg##*/}"
			[ -f "$jpg.422" ] && return 2
			[ -f "$jpg" ] && touch "$jpg.422"
			return 1
			;;
		429)
			wc_portal_set_retry "$resp.hdr"
			return 1
			;;
		*)
			return 1
			;;
	esac
}

# Ritenta le foto rimaste nella coda del portal, dalla più vecchia
portal_drain() {
	local budget start f sent=0 rc

	queue_enabled || return 0
	budget=$(drain_budget)
	start=$(date +%s)
	portal_queue_list > "$WORK_DIR/portal.lst"
	while IFS= read -r f; do
		[ $(( $(date +%s) - start )) -ge "$budget" ] && break
		portal_send "$f" 0 </dev/null
		rc=$?
		case "$rc" in
			0) queue_remove "$f"; sent=$(( sent + 1 )) ;;
			2)
				log "ERRORE: il portal ha rifiutato la foto in coda ${f##*/} ($PORTAL_REASON): spostata in $REJECTED_DIR."
				portal_reject "$f" "$PORTAL_REASON"
				;;
			*)
				log "ATTENZIONE: upload al portal della foto in coda ${f##*/} fallito ($PORTAL_REASON): riprovo al prossimo giro."
				break
				;;
		esac
	done < "$WORK_DIR/portal.lst"
	rm -f "$WORK_DIR/portal.lst"
	[ "$sent" -gt 0 ] && log "OK caricate sul portal $sent foto rimaste in coda, ne restano $(portal_queue_list | grep -c .)."
	return 0
}

# Foto nuova al portal. Imposta PORTAL_RESULT; ritorna 1 se non è arrivata.
portal_upload() {
	local rc jpg="$WORK_DIR/$FILENAME"

	queue_add "$jpg" "$FILENAME" "$PORTAL_QUEUE" || \
		log "ERRORE: impossibile mettere in coda $FILENAME per il portal (spazio libero in $QUEUE_DIR: $(free_kb "$QUEUE_DIR") KB): se l'upload fallisce la foto va persa"

	portal_send "$jpg" 1
	rc=$?
	case "$rc" in
		0)
			queue_enabled && queue_remove "$PORTAL_QUEUE/$FILENAME"
			PORTAL_RESULT=ok
			log "OK foto caricata: $FILENAME ($MODE${SPECIAL:+, $SPECIAL}, portal${PORTAL_REASON:+, $PORTAL_REASON})"
			return 0
			;;
		2)
			PORTAL_RESULT="rifiutata: $PORTAL_REASON"
			log "ERRORE: il portal ha rifiutato la foto $FILENAME ($PORTAL_REASON)"
			if queue_enabled && [ -f "$PORTAL_QUEUE/$FILENAME" ]; then
				portal_reject "$PORTAL_QUEUE/$FILENAME" "$PORTAL_REASON"
			fi
			return 1
			;;
		*)
			PORTAL_RESULT="$PORTAL_REASON"
			return 1
			;;
	esac
}

# Carica la foto locale $1 con il percorso remoto $2, più il suo .json
# (solo con "Upload data file": con il portal il .json esiste sempre)
upload_photo() {
	local jpg="$1" rel="$2"

	put_file "$jpg" "$rel" || return 1
	if [ "$WC_UPLOAD_DATA" = 1 ] && [ -f "${jpg%.jpg}.json" ]; then
		put_file "${jpg%.jpg}.json" "${rel%.jpg}.json" || \
			log "ATTENZIONE: upload del file di dati ${rel%.jpg}.json fallito ($(upload_reason))"
	fi
	return 0
}

# Ritenta le foto rimaste in coda per l'FTP, dalla più vecchia. Si ferma al
# primo errore (la rete è di nuovo giù) o quando il tempo è finito.
queue_drain() {
	local budget start f rel sent=0

	queue_enabled || return 0
	budget=$(drain_budget)
	start=$(date +%s)

	queue_list > "$WORK_DIR/queue.lst"
	while IFS= read -r f; do
		[ $(( $(date +%s) - start )) -ge "$budget" ] && break
		rel="${f#"$QUEUE_DIR"/}"
		if upload_photo "$f" "$rel" </dev/null; then
			queue_remove "$f"
			sent=$(( sent + 1 ))
		else
			log "ATTENZIONE: upload della foto in coda $rel fallito ($(upload_reason)): riprovo al prossimo giro."
			break
		fi
	done < "$WORK_DIR/queue.lst"
	rm -f "$WORK_DIR/queue.lst"
	[ "$sent" -gt 0 ] && log "OK caricate $sent foto rimaste in coda, ne restano $(queue_list | grep -c .)."
	return 0
}

# Destinazione FTP: foto nuova, copia current.jpg, coda. Esce con fail()
# se la foto nuova non arriva (come nella 1.0).
ftp_upload() {
	local dir archive latest reason

	dir="${WC_UPLOAD_DIRECTORY#/}"
	dir="${dir%/}"
	[ -n "$dir" ] && dir="$dir/"
	REMOTE_DIR="$dir"

	archive=""
	[ "$WC_UPLOAD_DATE_DIRS" = 1 ] && archive="$(date -d "@$NOW" +%Y/%m/%d)/"

	queue_add "$WORK_DIR/$FILENAME" "$archive$FILENAME" || \
		log "ERRORE: impossibile mettere in coda $FILENAME (spazio libero in $QUEUE_DIR: $(free_kb "$QUEUE_DIR") KB): se l'upload fallisce la foto va persa"
	queue_prune

	# Prima la foto nuova, così l'archivio e current.jpg sono aggiornati
	# subito anche quando ci sono foto arretrate da recuperare
	if ! upload_photo "$WORK_DIR/$FILENAME" "$archive$FILENAME"; then
		QUEUED=$(queue_count)
		reason="$(upload_reason)"
		wc_event upload.error warning "Upload FTP di $FILENAME fallito: $reason" \
			"{\"reason\":$(json_str "$reason"),\"queued\":$(json_num "$QUEUED")}"
		if queue_enabled; then
			fail "upload fallito verso $WC_UPLOAD_PROTOCOL://$WC_UPLOAD_SERVER/$dir$archive ($reason), foto in coda: $QUEUED"
		fi
		fail "upload fallito verso $WC_UPLOAD_PROTOCOL://$WC_UPLOAD_SERVER/$dir$archive ($reason)"
	fi
	queue_enabled && queue_remove "$QUEUE_DIR/$archive$FILENAME"

	log "OK foto caricata: $archive$FILENAME ($MODE${SPECIAL:+, $SPECIAL}, $WC_UPLOAD_PROTOCOL)"

	# Copia dell'ultima foto con nome fisso, per pagine web e incorporamenti
	if [ "$WC_UPLOAD_LATEST" = 1 ]; then
		latest="$WC_UPLOAD_LATEST_NAME"
		case "$latest" in
			''|*[!A-Za-z0-9._-]*) latest=current ;;
		esac
		latest="${latest%.jpg}"
		if put_file "$WORK_DIR/$FILENAME" "$latest.jpg" atomic; then
			if [ "$WC_UPLOAD_DATA" = 1 ]; then
				put_file "$WORK_DIR/$DATAFILE" "$latest.json" atomic || \
					log "ATTENZIONE: upload di $latest.json fallito"
			fi
		else
			log "ATTENZIONE: upload della copia $latest.jpg fallito ($(upload_reason))"
			FTP_RESULT="ok, ma copia $latest.jpg non caricata"
		fi
	fi
}

upload() {
	local result=ok has_portal=0 has_ftp=0
	FTP_RESULT=ok

	case "$TARGET" in
		portal) has_portal=1 ;;
		both) has_portal=1; has_ftp=1 ;;
		*) has_ftp=1 ;;
	esac

	if [ "$has_portal" = 1 ]; then
		wc_portal_enabled || \
			fail "portal non configurato: imposta portal_url e portal_token (Webcam > Portal) o scegli FTP come destinazione"
		case "$WC_PORTAL_URL" in
			http://*|https://*) ;;
			*) fail "portal_url non valido: deve iniziare con https://" ;;
		esac
	fi
	if [ "$has_ftp" = 1 ]; then
		[ -n "$WC_UPLOAD_SERVER" ] || fail "server di upload non configurato"
		if [ "$WC_UPLOAD_PROTOCOL" = sftp ]; then
			curl -V 2>/dev/null | grep -q '^Protocols:.*sftp' || \
				fail "il curl installato non supporta SFTP (serve curl compilato con libssh2)"
		fi
	fi

	# Con il portal il JSON photo/1 serve sempre (viaggia con la foto)
	if [ "$has_portal" = 1 ] || [ "$WC_UPLOAD_DATA" = 1 ]; then
		write_datafile
	fi

	setup_queue

	if [ "$has_portal" = 1 ]; then
		if ! portal_upload; then
			queue_prune
			QUEUED=$(queue_count)
			if [ "$has_ftp" = 0 ]; then
				queue_enabled && \
					fail "upload al portal di $FILENAME fallito ($PORTAL_RESULT), foto in coda: $QUEUED"
				fail "upload al portal di $FILENAME fallito ($PORTAL_RESULT)"
			fi
			log "ATTENZIONE: upload al portal di $FILENAME fallito ($PORTAL_RESULT), provo comunque l'FTP."
			result="ok via FTP, portal: $PORTAL_RESULT"
		else
			queue_prune
			portal_drain
		fi
	fi

	if [ "$has_ftp" = 1 ]; then
		ftp_upload
		[ "$FTP_RESULT" != ok ] && [ "$result" = ok ] && result="$FTP_RESULT"
		queue_drain
	fi

	QUEUED=$(queue_count)
	write_status "$result"
}

write_status running
# Senza orologio a batteria, dopo un riavvio l'ora può essere quella di
# mesi fa: capture_service aspetta NTP, qui si scarta solo il caso
# evidente (anche per gli scatti avviati a mano da LuCI).
if [ "$NO_UPLOAD" = 0 ] && [ "$(date -d "@$NOW" +%Y)" -lt 2025 ]; then
	fail "ora del router non valida ($(date -d "@$NOW")): attendo la sincronizzazione NTP"
fi
day_or_night
capture
after_shot
if [ "$NO_UPLOAD" = 1 ]; then
	log "Scatto di prova senza upload: $FILENAME ($MODE)"
	write_status test
else
	upload
	ping_monitor ok "foto $FILENAME caricata ($MODE${SPECIAL:+, $SPECIAL})"
fi
exit 0
